# Copia este archivo como .env.local para probar en tu computador.
# En Vercel: Project Settings > Environment Variables.

# En Vercel no hace falta nada: se usa Vercel AI Gateway con el token OIDC.
# Para probar en tu computador: `vercel env pull` o una clave del AI Gateway.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-3.5-flash

# Respaldo opcional con Google (https://aistudio.google.com/apikey):
# GEMINI_API_KEY=

# Opcional: usar Claude (Anthropic) en lugar de Gemini.
# ANTHROPIC_API_KEY=

# Opcional: forzar proveedor (gemini | claude) o modelo.
# IA_PROVEEDOR=gemini
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_MODEL=claude-haiku-4-5
