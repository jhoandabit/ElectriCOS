# Copia este archivo como .env.local para trabajar en tu computador:
#   Copy-Item .env.example .env.local
# En Vercel estas variables ya están configuradas (Settings > Environment Variables).

# Supabase (públicas: RLS protege los datos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA (secreta: solo la usa el servidor). Sin ella, la app funciona sin IA.
GEMINI_API_KEY=
IA_PROVEEDOR=gemini

# Opcionales
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=
