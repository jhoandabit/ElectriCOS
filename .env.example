# Copia este archivo como .env.local para probar en tu computador.
# En Vercel: Project Settings > Environment Variables.

# Opción recomendada para el colegio (tiene nivel gratuito):
# crea la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: usar Claude (Anthropic) en lugar de Gemini.
# ANTHROPIC_API_KEY=

# Opcional: forzar proveedor (gemini | claude) o modelo.
# IA_PROVEEDOR=gemini
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_MODEL=claude-haiku-4-5
